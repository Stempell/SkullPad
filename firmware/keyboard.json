{
    "manufacturer": "Wiktor Stepien",
    "keyboard_name": "skullpad",
    "maintainer": "Stempell",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "oled": true
    },
    "matrix_pins": {
        "cols": ["GP1", "GP2", "GP4"],
        "rows": ["GP28", "GP0"]
    },

    "encoder": {
        "rotary": [
            {
                "pin_a": "GP29",
                "pin_b": "GP3",
                "resolution": 4
            }
        ],
        "switch":[
            {
                "pin": "GP27"
            }
        ]
    },
    "processor": "RP2040",
    "url": "https://github.com/syntonos/myMacropad",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0001",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT_ortho_2x3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1}
            ]
        }
    }
}